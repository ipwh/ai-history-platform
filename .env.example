# ---------------------------------------------------------------------------
# 歷史自學互動網站：環境變數範例
# 使用方法：複製此檔案為 .env.local（Next.js 會自動載入），再按需要修改。
# 切勿把真實的 API key 提交到版本控制系統。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1. LLM provider（可選）
# 未設定時使用「本地示範生成」，不需要任何 API key，網站仍可完整運作。
# 可選值：mock（預設）｜deepseek｜openai-compatible｜gemini
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock

# --- 使用 DeepSeek 時（LLM_PROVIDER=deepseek）---
# 在 https://platform.deepseek.com/api_keys 取得 API key
# DEEPSEEK_API_KEY=
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com
#
# DeepSeek 官方模型的思考模式預設為開啟（強度 high）。出題屬結構化生成，毋須思維鏈，
# 因此本專案預設關閉思考模式以減少延遲及輸出費用；設 enabled 可改用思考模式，
# 亦可設 default 直接把參數交回 API 決定。
# LLM_THINKING=disabled
# 思考強度（只在 LLM_THINKING=enabled 時傳送）：low｜medium｜high｜max
# LLM_REASONING_EFFORT=high
#
# 單次回應的 token 上限。DeepSeek「JSON Output」文件要求設定此值，以免 JSON 被中途截斷；
# 設 off 表示不傳送此參數。
# LLM_MAX_TOKENS=8192
#
# JSON 模式偶爾會回傳空白內容，此值為自動重試次數（預設 1 次）。
# LLM_EMPTY_RETRIES=1

# --- 使用 Google Gemini 時（LLM_PROVIDER=gemini）---
# 在 Google AI Studio 取得 API key：https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- 使用 OpenAI 或相容 API 時（LLM_PROVIDER=openai-compatible）---
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# LLM 請求逾時（毫秒）
# LLM_TIMEOUT_MS=45000
# 真實 provider 失敗時，是否回退到本地示範生成（預設 true）
# LLM_ALLOW_MOCK_FALLBACK=true
# 單次回應的 token 上限（未設定時：DeepSeek 為 8192，其他 provider 不傳送此參數）
# LLM_MAX_TOKENS=8192
# 是否用 AI 按語意批改填充題及短答題（預設 true；設 false 則填充題只用字詞比對、
# 短答題只由學生自我檢查。本地示範模式（mock）永遠不會啟用 AI 批改）
# LLM_GRADING_ENABLED=true

# ---------------------------------------------------------------------------
# 2. 學生登入（學校 Google Workspace 帳戶，可選）
# 未設定時不會啟用登入，學生以匿名學習 ID 使用（本機示範模式）。
# 設定後學生必須以學校 Google 帳戶登入，學習記錄會跟隨帳戶。
#
# 設定步驟：
#   1. 在 https://console.cloud.google.com/apis/credentials 建立「OAuth 用戶端 ID」
#      （應用程式類型：網頁應用程式）。
#   2. 已授權的重新導向 URI 加入：http://localhost:3000/api/auth/google/callback
#      （正式環境請加入該網域的相同路徑）
#   3. 把用戶端 ID 及密碼填入下面兩個變數。
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 工作階段 cookie 的簽署密鑰（建議設定；未設定時自動使用 data/auth-secret.key）
# 可用 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` 產生
# AUTH_SECRET=

# 是否要求學生登入才可使用（預設 true；設為 false 可保留匿名使用）
# AUTH_REQUIRE_SIGN_IN=true

# 校內網域（完整標籤比對；只用於名冊推導電郵及顯示，不再影響角色判定）
# AUTH_SCHOOL_DOMAINS=pochiu.edu.hk

# 一律視為教師的電郵（以逗號分隔）
# 提示：本機測試教師端時，請把自己的電郵加入此處；正式部署時所有教師都必須列在此處，
#       未列出的帳戶一律是學生（角色只來自明確允許名單，見 README 第八節）。
# 註：學號形式（s 加數字）的電郵一律是學生，列在此處不會生效（會產生 error 級設定警示）。
# AUTH_TEACHER_EMAILS=

# 教職員存取政策（擁有者決定）：
#   allowlist（預設）= 最小權限：只有 AUTH_TEACHER_EMAILS／AUTH_ADMIN_EMAILS 內的帳戶是教職員
#   school-domain     = 暫時的全校教職員政策：AUTH_STAFF_DOMAINS 所列校內網域中「非學號形式」
#                       （^s\d+$ 除外的）帳戶一律是教師，可讀取全部學生的練習記錄。
#                       這是**全校**授權，不是最小權限政策；只應在擁有者明確授權下使用。
# 未設定或拼錯時一律退回 allowlist（fail-closed）。停用：設回 allowlist 或刪除此行，
# 現有工作階段會即時降權（不需等待到期）。學號形式的學生帳戶一律仍是學生。
# AUTH_STAFF_ACCESS_POLICY=allowlist

# 全校教職員政策的校內網域（完整標籤比對；只在 AUTH_STAFF_ACCESS_POLICY=school-domain 時生效）
# AUTH_STAFF_DOMAINS=pochiu.edu.hk

# 一律視為管理員的電郵（以逗號分隔）：管理員擁有教師的全部功能，
# 另可管理教材、OCR、課題發布及系統狀態（/admin 及 /api/admin/*）。
# 提示：同時出現在此處及 AUTH_TEACHER_EMAILS 時，以管理員為準。
# AUTH_ADMIN_EMAILS=

# 歷史科內容審核者名單（Sprint 12，逗號分隔的完整電郵）：
#   Golden Dataset fixture 核准，以及「已修復並核准」結構裁決，只接受此名單內的帳戶。
#   平台 teacher／admin 角色**不等於**歷史科學科資格；名單未設定時一律 fail-closed
#   （沒有人可以核准歷史科內容）。這份名單需要由科組／負責人正式指定。
# 注意：這不是角色設定，不會令帳戶成為教師或管理員；它只是額外的學科授權檢查。
# HISTORY_REVIEWER_EMAILS=

# OAuth 重新導向 URI（未設定時依瀏覽器請求的來源自動產生）
# AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---------------------------------------------------------------------------
# 2b. 學生名冊（Google Sheet／CSV，可選但建議）
# 名冊只存放班別、學號、姓名及電郵，不含密碼；學生仍然以學校 Google 帳戶登入。
# 啟用後：名冊內的學生會取得班別及學號；STUDENT_ROSTER_ENFORCE=true 時，
# 名冊以外的學生帳戶不可登入（教師帳戶不受名冊限制）。
#
# 三種來源（只選一種；未設定 STUDENT_ROSTER_SOURCE 時自動判斷）：
#   sheets-api ：以服務帳戶讀取私人 Google Sheet（建議正式環境使用）
#   csv        ：讀取「知道連結的任何人可檢視」的 Sheet CSV 匯出
#   file       ：讀取本機 CSV 檔案（離線或測試用）
#
# 名冊欄名會自動偵測（班別／班級／Class、學號／學生編號／Student ID、
# 姓名／學生姓名／Name、電郵／Email／學校電郵）。若表頭寫法特殊，
# 可用下面的 STUDENT_ROSTER_COLUMN_* 指定實際欄名。
# ---------------------------------------------------------------------------
# 是否啟用名冊（預設：只要設定了來源即啟用）
# STUDENT_ROSTER_ENABLED=true
# 名冊以外的學生可否登入（預設 = 啟用時 true，即不可登入）
# STUDENT_ROSTER_ENFORCE=true
# 來源：sheets-api｜csv｜file（未設定時：有 CSV 網址 → csv；有 Sheet ID → sheets-api；有檔案 → file）
# STUDENT_ROSTER_SOURCE=sheets-api

# 名冊所在的 Google Sheet（可由連結 /spreadsheets/d/<這段>/edit 取得）
# STUDENT_ROSTER_SHEET_ID=1RlzeojjxJqu8vk7ctTliVRahA1sXnR-BJRiyFMCr_uM
# 工作表名稱（留空 = 第一張工作表；此校名冊的第一張工作表名為「工作表1」）
# STUDENT_ROSTER_SHEET_NAME=
# 讀取的 A1 範圍（留空 = 由工作表名稱推導，例如 '名冊'!A1:Z2000）
# STUDENT_ROSTER_RANGE=

# 服務帳戶 JSON：① 直接貼上 JSON 內容，或 ② 填寫金鑰檔路徑
# （未設定時會嘗試 GOOGLE_APPLICATION_CREDENTIALS；Cloud Run 上建議由 Secret Manager 注入）
# 學校需把上述 Sheet 分享給服務帳戶電郵（檢視者權限）。
# STUDENT_ROSTER_SERVICE_ACCOUNT_JSON=

# CSV 匯出網址（source=csv 時使用；留空時由 SHEET_ID 自動組成）
# STUDENT_ROSTER_CSV_URL=
# 本機 CSV 檔案路徑（source=file 時使用）
# STUDENT_ROSTER_FILE=./data/student-roster.csv

# 名冊快取時間（秒，預設 600）；期間不會重複讀取 Google Sheet
# STUDENT_ROSTER_CACHE_TTL_SECONDS=600
# 名冊暫時無法讀取時是否仍允許登入（預設 false＝拒絕，避免未授權帳戶進入；
# 設為 true 可避免 Google 故障時全班無法登入，但安全性較低）
# STUDENT_ROSTER_FAIL_OPEN=false

# 只開放指定班別（留空 = 不設限）
#   STUDENT_ROSTER_CLASS_PREFIXES：以開頭比對（1,2,3 = 中一至中三；4 會接受 4A、4B…）
#   STUDENT_ROSTER_CLASSES：完全相等比對（1A,2B,3C）
# 範圍外的學生登入時會看到「本平台只開放中一至中三」的說明。
# STUDENT_ROSTER_CLASS_PREFIXES=1,2,3
# STUDENT_ROSTER_CLASSES=

# 欄名覆寫（未設定時自動偵測）
# 保良局蔡繼有中學的名冊欄名為 CLASSCODE（班別）、CLASSNO（班號）、
# ENNAME（英文姓名）、CHNAME（中文姓名）、SEX、EMAIL，
# 姓名預設使用中文姓名，因此設定：
# STUDENT_ROSTER_COLUMN_NAME=CHNAME
# STUDENT_ROSTER_COLUMN_EMAIL=EMAIL
# STUDENT_ROSTER_COLUMN_STUDENT_NUMBER=CLASSNO
# STUDENT_ROSTER_COLUMN_CLASS=CLASSCODE

# ---------------------------------------------------------------------------
# 3. OCR（教材圖片文字辨識，可選）
# 未設定時自動使用「本機 OCR」（tesseract.js），不需要 API key；
# 若已設定 OCR_API_KEY，則自動改用 Google Cloud Vision。
# 可選值：tesseract（預設）｜google-vision｜none（完全停用）
# ---------------------------------------------------------------------------
# OCR_PROVIDER=tesseract

# 辨識語言（tesseract 語言包名稱，以 + 分隔）。chi_tra = 繁體中文
# OCR_LANGUAGES=chi_tra
# 語言資料快取目錄（首次執行會由網絡下載，之後離線可用）
# OCR_CACHE_PATH=./data/ocr-cache
# 如要完全離線，可先下載 chi_tra.traineddata 到某個目錄，再指向該目錄
# OCR_LANG_PATH=
# 版面分析模式（tesseract PSM）；11 = SPARSE_TEXT，適合散佈文字的圖表
# OCR_PAGE_SEG_MODE=11
# 過濾雜訊：最少有效字元數、是否丟棄低信心結果（平均信心 < 0.3）
# OCR_MIN_CHARS=8
# OCR_SKIP_LOW_CONFIDENCE=true
# 每次執行 OCR 的圖片上限與逾時，避免一次執行過久
# OCR_MAX_IMAGES=150
# OCR_IMAGE_TIMEOUT_MS=60000
# OCR_RUN_TIMEOUT_MS=900000

# --- 使用 Google Cloud Vision 時（OCR_PROVIDER=google-vision）---
# 在 Google Cloud Console 建立 API key 並啟用 Vision API
# OCR_API_KEY=
# OCR_BASE_URL=https://vision.googleapis.com/v1

# ---------------------------------------------------------------------------
# 4. 資料儲存（可選）
# 預設使用專案內的 SQLite 檔案及本機上載目錄；生產環境建議改用 Cloud SQL 及
# Cloud Storage（介面已預留，見 README「Google Cloud Run 部署準備」）。
# 注意：容器檔案系統不是永久儲存，Cloud Run 每次重新部署或縮容都會清空。
# ---------------------------------------------------------------------------
# 資料庫檔案位置（本機預設 ./data/app.db）
# APP_DATABASE_PATH=./data/app.db
# 專案內附的教材來源資料夾（可打包進容器映像）
# APP_MATERIALS_DIR=./materials
# 教師上載教材的儲存目錄（本機預設 ./data/uploads）
# APP_UPLOADS_DIR=./data/uploads
# 上載大小上限及單一文件最大段落數
# APP_MAX_UPLOAD_BYTES=26214400
# APP_MAX_BLOCKS=4000

# 檔案儲存 provider：local（預設，本機檔案系統）｜gcs（Google Cloud Storage，尚未實作）
# 改用 gcs 時必須同時設定 GCS_BUCKET，並完成 src/server/storage/gcs.ts
# STORAGE_PROVIDER=local
# GCS_BUCKET=

# ---------------------------------------------------------------------------
# 4b. 資料持久化：Cloud Storage 備份（免費方案；部署到 Cloud Run 時建議啟用）
# Cloud Run 的容器檔案系統不會保留資料，因此平台會用 SQLite 內建機制產生一致快照
# （VACUUM INTO），定期上傳到 Cloud Storage，並在啟動時自動還原。
# 未設定 BACKUP_BUCKET 時完全不會啟用（本機開發不需要）。
# 物件很小（數 MB），一般落在 Cloud Storage 免費額度內。
# ---------------------------------------------------------------------------
# 備份用的 bucket 名稱（可寫 gs://name 或直接寫 name）
# BACKUP_BUCKET=
# bucket 內的物件前置路徑
# BACKUP_PREFIX=history
# 備份間隔秒數（預設 300 = 5 分鐘；備份在 API 請求週期內執行，因為 Cloud Run
# 閒置時會節流 CPU；設 0 表示只在啟動及關機時嘗試）
# BACKUP_INTERVAL_SECONDS=300
# 偵測到資料有變更時，兩次備份之間的最短間隔（預設 60 秒；越小則資料遺失窗口越小）
# BACKUP_MIN_SPACING_SECONDS=60
# 是否在啟動時由 Cloud Storage 還原資料庫（預設 true）
# BACKUP_RESTORE_ON_START=true
# 還原時以雲端版本為準（即使容器內已有資料庫）；Cloud Run 建議 true
# BACKUP_PREFER_CLOUD=false
# 是否啟用備份（設 false 可暫時停用，但保留 bucket 設定）
# BACKUP_ENABLED=true

# ---------------------------------------------------------------------------
# 5. 後台權限／API 保護
# 教師端（/teacher 及 /api/teacher/*）需要教師或管理員帳戶：題目、回報、學生練習記錄。
# 管理員端（/admin 及 /api/admin/*）需要管理員帳戶：教材、OCR、分節、課題發布、系統狀態。
#   教師或管理員帳戶 = AUTH_TEACHER_EMAILS／AUTH_ADMIN_EMAILS 內的帳號。
#   例外：擁有者明確授權的暫時政策 AUTH_STAFF_ACCESS_POLICY=school-domain 時，
#   AUTH_STAFF_DOMAINS 所列校內網域中「非學號形式」的帳戶也是教師（全校授權，見上）。
#   「校內網域但非學號形式即教師」的舊政策已**完全移除**：AUTH_IN_DOMAIN_ROLE 及
#   AUTH_ALLOW_LEGACY_IN_DOMAIN_TEACHER 不再被讀取，仍設定會產生 error 級設定警示。
#   學號形式（s 加數字）的帳戶一律是學生。
#   其他所有帳戶（校內、校外、別名、不在名冊者）一律是學生。
# 名冊只影響可否登入及顯示的班別學號，也不影響角色判定。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 未啟用登入時（本機示範模式）後台 API 完全開放，只適合本機開發；
# 另可設定 ADMIN_TOKEN，供自動化腳本以 x-admin-token 標頭呼叫後台 API。
# 注意：這個權杖等同管理員，會繞過所有角色檢查，因此最少需要 32 個字元
# （過短一律視為無效並回傳 401），亦只應存放於伺服器的環境變數或 Secret Manager。
# ---------------------------------------------------------------------------
# ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# 6. 示範模式行為
# 示範模式（LLM_PROVIDER=mock）下生成的題目是否自動發布，讓學生無需教師逐一審核
# 也可直接練習（介面會標示「本地示範生成（未使用 AI）」）。
# 正式環境請設為 false，由教師在「題目管理」核對後才發布。
# ---------------------------------------------------------------------------
# DEMO_AUTO_PUBLISH_QUESTIONS=true

# ---------------------------------------------------------------------------
# 6.1 教材自動開放（2026-10-21 擁有者指示）
# lesson-content（預設）：匯入課文／筆記後自動確認版權並開放給學生，令學生可即時
#   以課本內容 AI 出題自學。確認者記錄為 owner-policy:auto-open-all-materials
#   （不是假裝某位教師逐份確認）。
# off：回復逐份人手確認。
# 兩者都**不會**開放校內試題檔（題目與答案），亦**不會**代為完成教師版材料的
# 內容安全覆核（該項仍須管理員人手確認）。
# ---------------------------------------------------------------------------
# MATERIAL_AUTO_OPEN_POLICY=lesson-content

# ---------------------------------------------------------------------------
# 7. Google Cloud Run 部署（選用；由部署指令碼或 Cloud Run 環境注入）
# 詳細步驟見 README「十、本機開發與 Google Cloud Run 部署準備」。
# 映像檔（Dockerfile）已內建下列預設值，一般毋須自行設定：
#   PORT=8080、HOSTNAME=0.0.0.0、APP_DATABASE_PATH=/tmp/data/app.db、
#   APP_UPLOADS_DIR=/tmp/data/uploads、OCR_CACHE_PATH=/tmp/data/ocr-cache、
#   OCR_LANG_PATH=/app/ocr-lang、APP_MATERIALS_DIR=/app/materials
# 憑證一律由 Secret Manager 注入（AUTH_SECRET、DEEPSEEK_API_KEY、
# STUDENT_ROSTER_SERVICE_ACCOUNT_JSON），切勿寫進映像檔或版本控制。
# ---------------------------------------------------------------------------
# 建議在 Cloud Run 設定的環境變數：
#   AUTH_REQUIRE_SIGN_IN=true
#   DEMO_AUTO_PUBLISH_QUESTIONS=false
#   MATERIAL_AUTO_OPEN_POLICY=lesson-content
#   HISTORY_REVIEWER_EMAILS=<歷史科教師電郵，以分號分隔>
#   STUDENT_ROSTER_ENABLED=true
#   STUDENT_ROSTER_ENFORCE=true
#   STUDENT_ROSTER_SOURCE=sheets-api
#   BACKUP_BUCKET=<專案 ID>-history-backup
#   BACKUP_PREFIX=history
#   BACKUP_INTERVAL_SECONDS=300
#   BACKUP_RESTORE_ON_START=true
#   BACKUP_PREFER_CLOUD=true
# 並為 Cloud Run 執行身分授予該 bucket 的 roles/storage.objectAdmin。
# （scripts/deploy-cloud-run.ps1 -Apply 會自動建立 bucket 及授權。）

# 若改用持久化儲存（Filestore／Cloud Storage volume 掛載），請覆寫資料位置：
#   APP_DATABASE_PATH=/mnt/history/app.db
#   APP_UPLOADS_DIR=/mnt/history/uploads
#   OCR_CACHE_PATH=/mnt/history/ocr-cache
